{{!
    @template local_mooc_audit/run_summary

    "Since the previous audit" box above the report of the audit page (specs/005).

    Context variables required for this template:
    * runid, status (code, label, cssclass), historyurl, historylabel, evolutionurl
    * first, comparable, nochange, counts[] (code, label, count, cssclass), notes[], haserrors, errors[] (label, rule, message)

    Example context (json):
    {
        "runid": 12, "status": {"code": "complete", "label": "Complete", "cssclass": "badge-success"},
        "historyurl": "#", "historylabel": "Audit history (3)", "evolutionurl": "#",
        "first": false, "comparable": true, "nochange": false,
        "counts": [{"code": "resolved", "label": "Resolved", "count": 1, "cssclass": "badge-success"}],
        "notes": [], "haserrors": false, "errors": []
    }
}}
<div class="local_mooc_audit-runsummary card mb-3" data-region="run-summary">
    <div class="card-body py-2">
        <h4 class="h6 mb-2">{{#str}} evolution_summary, local_mooc_audit {{/str}}
            <small class="text-muted">({{#str}} label_runid, local_mooc_audit {{/str}} {{runid}},
                <span class="badge {{status.cssclass}}">{{status.label}}</span>)</small></h4>
        {{#first}}<p class="mb-1">{{#str}} evolution_first, local_mooc_audit {{/str}}</p>{{/first}}
        {{#comparable}}
            {{#nochange}}<p class="mb-1">{{#str}} evolution_none, local_mooc_audit {{/str}}</p>{{/nochange}}
            <ul class="list-inline mb-1">
                {{#counts}}<li class="list-inline-item"><span class="badge {{cssclass}}" data-evolution="{{code}}">{{label}}: {{count}}</span></li>{{/counts}}
            </ul>
        {{/comparable}}
        {{#notes}}<p class="small text-muted mb-1">{{.}}</p>{{/notes}}
        {{#haserrors}}
            <ul class="small mb-1">{{#errors}}<li><strong>{{label}}</strong>{{#rule}} ({{rule}}){{/rule}}: {{message}}</li>{{/errors}}</ul>
        {{/haserrors}}
        <a href="{{evolutionurl}}" class="mr-3">{{#str}} evolution_details, local_mooc_audit {{/str}}</a>
        <a href="{{historyurl}}">{{historylabel}}</a>
    </div>
</div>
