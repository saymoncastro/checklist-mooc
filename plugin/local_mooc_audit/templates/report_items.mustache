{{!
    @template local_mooc_audit/report_items
    Table of result rows (specs/006), shared by the views by priority (report_group) and by activity (report_activity).
    Context variables required for this template:
    * items[] - see local_mooc_audit/report_group, plus anchor, impact, evidencekind, samecause, samecauseanchor,
      alsosolves, whoyou and verifyspecific (all optional)
    Example context (json):
    {
        "items": [{"rule": "CL-13", "title": "Quizzes with at least two attempts", "statuslabel": "Non conformant",
            "statusclass": "bg-danger text-white", "severitylabel": "High", "impact": "breaks the institutional policy",
            "anchor": "local_mooc_audit-occ-1", "presented": true, "problem": "The quiz Quiz 1 allows fewer attempts than required.",
            "place": "Quiz 1", "why": "The policy gives learners at least 2 attempts.", "fix": "Change Attempts allowed.",
            "who": "You can do this.", "whoyou": true, "verify": "Run the audit again.", "evidencia": "attempts=1",
            "check": "attempts", "occurrence": "CL-13|cm:1|attempts"}]
    }
}}
<div class="table-responsive">
<table class="table table-sm table-striped local_mooc_audit-items">
    <thead>
        <tr>
            <th scope="col" class="w-25">{{#str}} label_problem, local_mooc_audit {{/str}}</th>
            <th scope="col">{{#str}} label_status, local_mooc_audit {{/str}}</th>
            <th scope="col">{{#str}} label_todo, local_mooc_audit {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#items}}
            <tr class="local_mooc_audit-item"{{#anchor}} id="{{anchor}}"{{/anchor}} data-rule="{{rule}}" data-check="{{check}}">
                <td data-label="{{#str}} label_problem, local_mooc_audit {{/str}}">
                    {{#presented}}<strong class="local_mooc_audit-problem">{{problem}}</strong>{{/presented}}
                    {{^presented}}<strong>{{rule}}</strong> {{title}}{{/presented}}
                    <br><span class="small">{{#haslink}}<a href="{{link}}" title="{{linktitle}}">{{#presented}}{{place}}{{/presented}}{{^presented}}{{local}}{{/presented}}</a>{{/haslink}}{{^haslink}}{{#presented}}{{place}}{{/presented}}{{^presented}}{{local}}{{/presented}}{{/haslink}}</span>
                    {{#presented}}<br><small class="text-muted">{{rule}} · {{title}}</small>{{#evidencekind}}<br><span class="badge bg-light text-dark border">{{evidencekind}}</span>{{/evidencekind}}{{/presented}}
                </td>
                <td data-label="{{#str}} label_status, local_mooc_audit {{/str}}"><span class="badge {{statusclass}}">{{statuslabel}}</span><br><small>{{severitylabel}}{{#impact}} · {{impact}}{{/impact}}</small></td>
                <td class="local_mooc_audit-todo" data-label="{{#str}} label_todo, local_mooc_audit {{/str}}">
                    {{#samecause}}<p class="mb-1 small local_mooc_audit-samecause"><a href="#{{samecauseanchor}}">{{samecause}}</a></p>{{/samecause}}
                    {{#presented}}
                    {{#found}}<p class="mb-1 local_mooc_audit-foundrequired"><strong>{{#str}} label_found, local_mooc_audit {{/str}}:</strong> {{found}} · <strong>{{#str}} label_expected, local_mooc_audit {{/str}}:</strong> {{required}}</p>{{/found}}
                    <p class="mb-1"><strong>{{#str}} label_why, local_mooc_audit {{/str}}:</strong> {{why}}</p>
                    {{#hasrelated}}<p class="mb-1 small local_mooc_audit-related">{{#str}} related_chain, local_mooc_audit {{/str}}</p><ul class="mb-1 small">{{#related}}<li><a href="#{{anchor}}">{{problem}}</a></li>{{/related}}</ul>{{/hasrelated}}
                    {{#alsosolves}}<p class="mb-1 small local_mooc_audit-alsosolves">{{alsosolves}}</p>{{/alsosolves}}
                    {{#before}}<p class="mb-1 text-danger local_mooc_audit-before"><strong>{{before}}</strong></p>{{/before}}
                    <p class="mb-1"><strong>{{#str}} label_fix, local_mooc_audit {{/str}}:</strong> {{fix}}</p>
                    {{#hasalternatives}}<ul class="mb-1">{{#alternatives}}<li>{{text}}</li>{{/alternatives}}</ul>{{/hasalternatives}}
                    {{#hasactions}}<ul class="list-unstyled mb-1 local_mooc_audit-fixactions">{{#actions}}<li><a href="{{url}}">{{label}}</a></li>{{/actions}}</ul>{{/hasactions}}
                    {{^whoyou}}<p class="mb-1 small local_mooc_audit-who"><strong>{{#str}} label_who, local_mooc_audit {{/str}}:</strong> {{who}}</p>{{/whoyou}}
                    {{#verifyspecific}}<p class="mb-1 small"><strong>{{#str}} label_verify, local_mooc_audit {{/str}}:</strong> {{verify}}</p>{{/verifyspecific}}
                    {{#correctionurl}}<a class="btn btn-sm btn-outline-primary mt-1" href="{{correctionurl}}">{{#str}} fix_seeproposal, local_mooc_audit {{/str}}</a>{{/correctionurl}}
                    <details class="mt-1 small local_mooc_audit-technical">
                        <summary>{{#str}} label_technical, local_mooc_audit {{/str}}</summary>
                        <dl class="mb-0">
                            <dt>{{#str}} label_rule, local_mooc_audit {{/str}}</dt><dd>{{rule}} — {{title}} · {{#str}} label_check, local_mooc_audit {{/str}}: {{check}}</dd>
                            <dt>{{#str}} label_evidence, local_mooc_audit {{/str}}</dt><dd>{{evidencia}}</dd>
                            {{#hasfound}}<dt>{{#str}} label_found, local_mooc_audit {{/str}}</dt><dd>{{encontrado}}</dd>{{/hasfound}}
                            {{#hasexpected}}<dt>{{#str}} label_expected, local_mooc_audit {{/str}}</dt><dd>{{esperado}}</dd>{{/hasexpected}}
                            {{#hasorientacao}}<dt>{{#str}} label_recorded_guidance, local_mooc_audit {{/str}}</dt><dd>{{orientacao}}</dd>{{/hasorientacao}}
                            <dt>{{#str}} label_who, local_mooc_audit {{/str}}</dt><dd>{{who}}</dd>
                            <dt>{{#str}} label_occurrence, local_mooc_audit {{/str}}</dt><dd><code>{{occurrence}}</code></dd>
                        </dl>
                    </details>
                    {{/presented}}
                    {{^presented}}
                    <p class="mb-1">{{evidencia}}</p>
                    {{#hasdetails}}<dl class="mb-1 small">{{#hasfound}}<dt>{{#str}} label_found, local_mooc_audit {{/str}}</dt><dd>{{encontrado}}</dd>{{/hasfound}}{{#hasexpected}}<dt>{{#str}} label_expected, local_mooc_audit {{/str}}</dt><dd>{{esperado}}</dd>{{/hasexpected}}</dl>{{/hasdetails}}
                    {{#hasorientacao}}<p class="mb-1">{{orientacao}}</p>{{/hasorientacao}}
                    {{#correctionurl}}<a class="btn btn-sm btn-outline-primary mt-1" href="{{correctionurl}}">{{#str}} fix_seeproposal, local_mooc_audit {{/str}}</a>{{/correctionurl}}
                    {{/presented}}
                </td>
            </tr>
        {{/items}}
    </tbody>
</table>
</div>
