{{!
    @template local_mooc_audit/comparison_diffs

    Table of classified differences (comparison contract 1.0).

    Context variables required for this template:
    * diffs[] - objects with kindlabel, kindclass, field, source, target, explanation

    Example context (json):
    {
        "diffs": [{"kindlabel": "Relevant", "kindclass": "badge-danger", "field": "extra.attempts", "source": "2", "target": "1",
            "explanation": "Setting changed (extra.attempts: 2 → 1)."}]
    }
}}
<table class="table table-sm table-bordered local_mooc_audit-diffs">
    <thead>
        <tr>
            <th scope="col">{{#str}} cmp_kind, local_mooc_audit {{/str}}</th>
            <th scope="col">{{#str}} cmp_field, local_mooc_audit {{/str}}</th>
            <th scope="col">{{#str}} cmp_values, local_mooc_audit {{/str}}</th>
            <th scope="col">{{#str}} cmp_explanation, local_mooc_audit {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#diffs}}
        <tr class="local_mooc_audit-diff local_mooc_audit-diff-{{kind}}">
            <td><span class="badge {{kindclass}}">{{kindlabel}}</span></td>
            <td><code>{{field}}</code></td>
            <td>{{source}} → {{target}}</td>
            <td>{{explanation}}</td>
        </tr>
        {{/diffs}}
    </tbody>
</table>
