{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cefor.ifes.edu.br/schemas/local_mooc_audit/report-1.0.json",
  "title": "Relatório de auditoria MOOC (local_mooc_audit) — contrato 1.0",
  "type": "object",
  "required": ["contract_version", "engine", "policy_version", "reoffer_year", "executed_at", "course", "summary", "results", "warnings", "inventory"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "engine": {"type": "string", "pattern": "^local_mooc_audit "},
    "policy_version": {"type": "string"},
    "policy_warnings": {"type": "array", "items": {"type": "string"}},
    "reoffer_year": {"type": "integer"},
    "executed_at": {"type": "string"},
    "course": {
      "type": "object",
      "required": ["id", "shortname", "fullname"],
      "properties": {"id": {"type": "integer"}, "shortname": {"type": "string"}, "fullname": {"type": "string"}}
    },
    "viewer_userid": {"type": "integer"},
    "timing": {"type": "object", "properties": {"snapshot_s": {"type": "number"}, "total_s": {"type": "number"}}},
    "inventory": {"type": "object"},
    "summary": {
      "type": "object",
      "required": ["por_status", "nao_conformes_por_gravidade", "regras", "overall_status"],
      "properties": {
        "por_status": {"type": "object", "additionalProperties": {"type": "integer"}},
        "nao_conformes_por_gravidade": {"type": "object", "additionalProperties": {"type": "integer"}},
        "regras": {"type": "integer"},
        "overall_status": {"enum": ["BLOQUEADA", "REQUER_CORRECOES", "SEM_INCONFORMIDADES"]}
      }
    },
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "snapshot": {"type": "object"}
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": ["rule", "titulo", "origem", "category", "tipo", "status", "gravidade", "local", "evidencia", "encontrado", "esperado", "orientacao", "cmid", "locus", "link"],
      "properties": {
        "rule": {"type": "string", "pattern": "^(CL-[0-9]{2}|X-[A-Z]+-[0-9]{2})$"},
        "titulo": {"type": "string"},
        "origem": {"type": "string"},
        "classe": {"type": "string"},
        "category": {"enum": ["offer_enrol", "institutional_resources", "assessment_grades", "completion_restrictions", "certification", "content_files", "structure_blocks", "plugins_environment"]},
        "tipo": {"enum": ["institucional", "tecnica"]},
        "status": {"enum": ["CONFORME", "NAO_CONFORME", "ATENCAO", "NAO_APLICAVEL", "NAO_VERIFICAVEL", "ERRO"]},
        "gravidade": {"enum": ["Bloqueante", "Alta", "Média", "Baixa", "Informativa"]},
        "local": {"type": ["string", "null"]},
        "cmid": {"type": ["integer", "null"]},
        "locus": {"enum": ["module_edit", "module_view", "course_settings", "enrol", "gradebook", "blocks", "section", "import", "none"]},
        "section": {"type": ["integer", "null"]},
        "link": {"type": ["string", "null"]},
        "evidencia": {"type": ["string", "null"]},
        "encontrado": {"type": ["string", "null"]},
        "esperado": {"type": ["string", "null"]},
        "orientacao": {"type": ["string", "null"]},
        "occurrence": {"type": "string", "pattern": "^(CL-[0-9]{2}|X-[A-Z]+-[0-9]{2})\\|(course|cm:[0-9]+|sec:[0-9]+)\\|", "description": "Stable occurrence key rule|entity|check[|subject] (specs/005, additive)"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "NAO_CONFORME"}}}, "then": {"properties": {"local": {"type": "string", "minLength": 1}, "evidencia": {"type": "string", "minLength": 1}, "orientacao": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"status": {"const": "ATENCAO"}}}, "then": {"properties": {"local": {"type": "string", "minLength": 1}, "evidencia": {"type": "string", "minLength": 1}}}}
      ]
    }
  }
}
