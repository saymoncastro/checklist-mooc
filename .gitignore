extract/
poc-work/
*.tmp
__pycache__/
*.pyc

# Sistema
.DS_Store

# Ambiente Moodle local (código do Moodle + moodle-docker); não versionar
moodle-local/

# Pacotes gerados por tools/package-plugin.sh
dist/
